{
  "name": "@bartvanderwal/brightspacosaurus",
  "version": "0.9.1",
  "description": "CLI that turns Markdown course material into a Brightspace/D2L Common Cartridge (.imscc): quizzes become native QTI 1.2 assessments, readers become PDFs, PlantUML/Mermaid diagrams render automatically, and a Docusaurus preview lets you check formatting before import.",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/main.ts",
    "./config": "./src/config-loader.ts",
    "./scanner": "./src/source-scanner.ts",
    "./markdown": "./src/markdown-converter.ts",
    "./quiz": "./src/quiz-converter.ts",
    "./reader": "./src/reader-pdf-converter.ts",
    "./manifest": "./src/manifest-builder.ts",
    "./packer": "./src/packer.ts"
  },
  "tasks": {
    "prepare": "deno run --allow-read --allow-write --allow-run=pandoc,git --allow-env --allow-net --node-modules-dir=auto src/main.ts prepare",
    "pack": "deno run --allow-read --allow-write --allow-env src/main.ts pack",
    "check": "deno check src/mod.ts src/main.ts",
    "lint": "deno lint",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env --allow-net=127.0.0.1 tests/"
  },
  "fmt": {
    "proseWrap": "never",
    "exclude": [
      "**/*.md"
    ]
  },
  "lint": {
    "exclude": [
      "spike/"
    ]
  },
  "imports": {
    "fast-check": "npm:fast-check@^4.7.0",
    "jszip": "npm:jszip@^3.10.0",
    "unified": "npm:unified@^11.0.0",
    "remark-parse": "npm:remark-parse@^11.0.0",
    "remark-frontmatter": "npm:remark-frontmatter@^5.0.0",
    "remark-gfm": "npm:remark-gfm@^4.0.0",
    "remark-kroki-a11y": "npm:remark-kroki-a11y@0.6.3",
    "remark-rehype": "npm:remark-rehype@^11.0.0",
    "rehype-external-links": "npm:rehype-external-links@^3.0.0",
    "rehype-raw": "npm:rehype-raw@^7.0.0",
    "rehype-stringify": "npm:rehype-stringify@^10.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "publish": {
    "include": [
      "src/",
      "src/mod.ts",
      "assets/brightspacosaurus.css",
      "assets/reader-header.tex",
      "assets/include-filter.lua",
      "assets/diagram-filter.lua",
      "CHANGELOG.md",
      "docs/user-manual.md",
      "docs/software-guidebook.md",
      "README.md",
      "deno.json"
    ]
  }
}
