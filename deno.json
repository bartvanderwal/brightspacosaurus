{
  "name": "@bartvanderwal/brightspacosaurus",
  "version": "0.31.0",
  "description": "CLI that turns Markdown course material into a Brightspace/D2L Common Cartridge (.imscc): quizzes become native QTI 1.2 assessments, readers become PDFs, PlantUML/Mermaid diagrams render automatically, and a Docusaurus preview lets you check formatting before import.",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/main.ts",
    "./config": "./src/config-loader.ts",
    "./scanner": "./src/source-scanner.ts",
    "./markdown": "./src/markdown-converter.ts",
    "./quiz": "./src/quiz-converter.ts",
    "./reader": "./src/reader-pdf-converter.ts",
    "./manifest": "./src/manifest-builder.ts",
    "./packer": "./src/packer.ts",
    "./flashcards": "./src/flashcards.ts",
    "./lint": "./src/course-linter.ts",
    "./quiz-preview": "./src/quiz-preview.ts",
    "./teacher-page": "./src/teacher-page.ts",
    "./tabs": "./assets/brightspacosaurus-tabs.js",
    "./quizzes-client": "./assets/brightspacosaurus-quizzes.js",
    "./flashcards-client": "./assets/brightspacosaurus-flashcards.js",
    "./slides-client": "./assets/brightspacosaurus-slides.js",
    "./slides-remark": "./src/slides-preview-remark.ts"
  },
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-run=pandoc,git,npm --allow-env --allow-net --node-modules-dir=auto src/main.ts build",
    "pack": "deno run --allow-read --allow-write --allow-env src/main.ts pack",
    "check": "deno check src/mod.ts src/main.ts",
    "lint": "deno lint",
    "test": "deno run --allow-read=build --allow-write=build --allow-run=deno utils/test-runner.ts all",
    "test:fast": "deno run --allow-read=build --allow-write=build --allow-run=deno utils/test-runner.ts fast",
    "test:pdf": "deno run --allow-read=build --allow-write=build --allow-run=deno utils/test-runner.ts pdf",
    "demo": "deno task preview",
    "preview": "deno run --allow-read --allow-write=build,demo-course-docs --allow-env --allow-run=npm --allow-net src/main.ts preview",
    "demo:pack": "cd examples/demo-course && deno run -A ../../src/main.ts build && deno run -A ../../src/main.ts pack",
    "stop": "deno run --allow-run=lsof,ps utils/stop-preview.ts",
    "lint:demo": "deno run --allow-read --allow-env src/main.ts lint",
    "lint:antipatterns": "cd examples/demo-course-antipatterns && deno run -P ../../src/main.ts lint",
    "lint:docs": "deno run --allow-read --allow-env src/main.ts lint --sources docs",
    "publish": "deno task release",
    "release": "deno run --allow-read --allow-run=git,deno utils/release.ts",
    "release:npm": "deno run --allow-read --allow-write=build --allow-run=npm,deno,tar utils/release-npm.ts"
  },
  "fmt": {
    "proseWrap": "never",
    "exclude": [
      "**/*.md"
    ]
  },
  "permissions": {
    "default": {
      "read": true,
      "write": true,
      "run": true,
      "env": true,
      "net": ["127.0.0.1"]
    }
  },
  "test": {
    "include": ["tests/"]
  },
  "lint": {
    "exclude": [
      "spike/",
      "assets/teacher-dashboard/vendor/"
    ]
  },
  "imports": {
    "fast-check": "npm:fast-check@^4.7.0",
    "jszip": "npm:jszip@^3.10.0",
    "pptxgenjs": "npm:pptxgenjs@^4.0.1",
    "image-size": "npm:image-size@^2.0.2",
    "unified": "npm:unified@^11.0.0",
    "remark-parse": "npm:remark-parse@^11.0.0",
    "remark-frontmatter": "npm:remark-frontmatter@^5.0.0",
    "remark-directive": "npm:remark-directive@^3.0.0",
    "remark-gfm": "npm:remark-gfm@^4.0.0",
    "remark-kroki-a11y": "npm:remark-kroki-a11y@0.6.3",
    "remark-rehype": "npm:remark-rehype@^11.0.0",
    "rehype-external-links": "npm:rehype-external-links@^3.0.0",
    "rehype-prism-plus": "npm:rehype-prism-plus@^2.0.0",
    "rehype-raw": "npm:rehype-raw@^7.0.0",
    "rehype-stringify": "npm:rehype-stringify@^10.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "publish": {
    "include": [
      "src/",
      "src/mod.ts",
      "assets/brightspacosaurus.css",
      "assets/brightspacosaurus.png",
      "assets/brightspacosaurus-flashcards.js",
      "assets/brightspacosaurus-flashcards.d.ts",
      "assets/brightspacosaurus-quizzes.d.ts",
      "assets/brightspacosaurus-navigation.js",
      "assets/brightspacosaurus-tabs.js",
      "assets/brightspacosaurus-tabs.d.ts",
      "assets/brightspacosaurus-slides.js",
      "assets/brightspacosaurus-slides.d.ts",
      "assets/brightspacosaurus-copy-button.js",
      "assets/reader-header.tex",
      "assets/include-filter.lua",
      "assets/details-filter.lua",
      "assets/diagram-filter.lua",
      "assets/chapter-filter.lua",
      "CHANGELOG.md",
      "docs/user-manual.md",
      "docs/quizzosaurus-syntax.md",
      "docs/software-guidebook.md",
      "README.md",
      "deno.json",
      "assets/brightspacosaurus-quizzes.js",
      "assets/teacher-dashboard/"
    ]
  }
}
