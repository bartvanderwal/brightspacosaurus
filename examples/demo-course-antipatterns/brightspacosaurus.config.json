{
  "courseName": "Lint Antipatterns",
  "version": "0.11.2",
  "sourcesDir": "lessons",
  "outputDir": "build/brightspace",
  "flashcards": {
    "sectionHeadings": [
      "Core concepts"
    ]
  },
  "lint": {
    "includeDirs": [
      "lessons"
    ],
    "quizBias": {
      "giveawayWords": [
        "only"
      ]
    }
  },
  "slides": {
    "lessons": {
      "metadata/slides-unnumbered-headings.md": {
        "generate": true,
        "decks": "decks/*.md"
      },
      "metadata/slides-too-many-sections.md": {
        "generate": true
      },
      "metadata/slides-section-without-content.md": {
        "generate": true
      },
      "metadata/slides-too-many-nested.md": {
        "generate": true,
        "nest": [
          "nest-many/page-*.md"
        ]
      },
      "metadata/slides-nest-unused.md": {
        "generate": true,
        "nest": [
          "missing-folder/*.md"
        ]
      },
      "metadata/slides-appendix-not-last.md": {
        "generate": true
      }
    }
  }
}
